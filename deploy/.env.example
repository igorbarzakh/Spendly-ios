SPENDLY_DOMAIN=api.spendly.app
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=spendly
POSTGRES_USER=spendly
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://spendly:replace-with-url-encoded-password@postgres:5432/spendly?sslmode=disable

# Base64 without padding of a 64-byte Ed25519 private key.
TOKEN_SIGNING_KEY=replace-with-base64-ed25519-private-key
APPLE_CLIENT_ID=app.spendly.ios
GOOGLE_CLIENT_ID=298809492431-t6pi2e7j0ljfaenuip6c4q549q9h1qg8.apps.googleusercontent.com

SPENDLY_API_IMAGE=spendly-api
SPENDLY_MIGRATE_IMAGE=spendly-migrate
SPENDLY_API_TAG=local

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

BACKUP_DIR=/var/backups/spendly
BACKUP_RETENTION_DAYS=14
AGE_RECIPIENT=age1replace-with-backup-public-key
AGE_IDENTITY_FILE=/root/.config/age/spendly-backup-key.txt
